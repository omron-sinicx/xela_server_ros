<launch>
    <arg name="software_version" default="v1.8.0"/>
    <arg name="file" default="$(find xela_server_ros)/software/$(arg software_version)/config/xServ.ini"/>
    <arg name="port" default="5000"/>
    <arg name="ip" default="127.0.0.1"/>
    <arg name="d" default="0"/>

    <node pkg="xela_server_ros" name="xela_server" type="xela_server" required="true" args="-f $(arg file) --port $(arg port) --ip $(arg ip) --software_version $(arg software_version)" />
    <node pkg="xela_server_ros" type="xela_service" name="xela_service" required="true" args="--port $(arg port) --ip $(arg ip) -d $(arg d) -s $(arg software_version)" />
</launch>