APPDIR=$ORIGIN
APPIMAGE_UUID=Arjbrio
APPDIR_EXEC_PATH=$APPDIR/usr/bin/xela_server
APPDIR_EXEC_ARGS=$@
XDG_DATA_DIRS=$APPDIR/usr/local/share:$APPDIR/usr/share:$XDG_DATA_DIRS
XDG_CONFIG_DIRS=$APPDIR/etc/xdg:$XDG_CONFIG_DIRS
APPDIR_LIBRARY_PATH=$APPDIR/lib/x86_64:$APPDIR/lib/x86_64-linux-gnu:$APPDIR/lib/x86_64
PATH=$APPDIR:$APPDIR/lib/x86_64:$APPDIR/usr/bin:$PATH
GTK_EXE_PREFIX=$APPDIR/usr
GTK_DATA_PREFIX=$APPDIR/usr
APPDIR_LIBC_LIBRARY_PATH=$APPDIR/runtime/compat/lib64:$APPDIR/runtime/compat/lib/x86_64-linux-gnu:$APPDIR/runtime/compat/usr/lib/x86_64-linux-gnu/gconv
APPDIR_LIBC_VERSION=2.35
APPDIR_PATH_MAPPINGS=/home/xela/compiled_tests/server/AppDir:$APPDIR;
APPDIR_LIBC_LINKER_PATH={'lib64/ld-linux-x86-64.so.2'}
